# H7 fork extensions retained during STM32 configuration commonization.
# Sourced only inside ARCH_CHIP_STM32H7.

config STM32_USART_SYNCHRONOUS
	bool "Synchronous mode support"
	default n
	depends on STM32_USART
	---help---
		Enable synchronous mode for USARTs. The option enables support for the
		TIOCSSYNCHRONOUS ioctl in the STM32H7 serial driver.

config STM32_USART_BITORDER
	bool "Set bit order support"
	default n
	depends on STM32_USART
	---help---
		Enable setting bit order (MSB first/LSB first) for U(S)ARTs. The option
		enables support for the TIOCSBITORDER ioctl in the STM32H7 serial driver.

